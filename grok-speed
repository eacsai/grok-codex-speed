#!/bin/sh
# Measure Grok model tokens/s (thinking + writing). Tool time is excluded
# because tools are disabled and the timer is duration_api_ms.
#
# Default model/effort come from ~/.grok/config.toml (currently grok-4.6 / xhigh).
# Default prompt targets ~2000 output tokens (models may cap earlier).
# Usage:
#   grok-speed
#   grok-speed 3
#   grok-speed --effort high
#   grok-speed -m grok-4 --effort low
#   grok-speed --model grok-4.6 --effort xhigh 3
#   grok-speed --effort max "your prompt"
# Effort: none | minimal | low | medium | high | xhigh | max

set -u

GROK="${GROK_BIN:-$HOME/.local/bin/grok}"
if [ ! -x "$GROK" ]; then
  GROK=$(command -v grok 2>/dev/null || true)
fi
if [ ! -x "$GROK" ]; then
  echo "grok-speed: grok not found" >&2
  exit 127
fi

repeats=1
model=
effort=
# ~1500 English words is roughly 2000 tokens; short replies make tok/s noisy.
prompt='Do not use any tools. Write a continuous English technical essay of about 1500 words (target roughly 2000 tokens) on TCP congestion control: slow start, congestion avoidance, fast retransmit, fast recovery, Reno, CUBIC, and BBR. Use numbered sections and concrete examples. Do not stop early. End with a final line that contains only: DONE'

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

need_val() {
  [ "${2:-}" != "" ] || { echo "grok-speed: $1 needs a value" >&2; exit 2; }
}

while [ "$#" -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    -m|--model)
      need_val "$1" "${2:-}"
      model=$2
      shift 2
      ;;
    --effort|--reasoning-effort)
      need_val "$1" "${2:-}"
      effort=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "grok-speed: unknown flag $1" >&2
      exit 2
      ;;
    *[!0-9]*)
      prompt=$1
      shift
      ;;
    *)
      repeats=$1
      [ "$repeats" -ge 1 ] || { echo "grok-speed: repeats must be >= 1" >&2; exit 2; }
      shift
      [ "${1:-}" = "" ] || { prompt=$1; shift; }
      ;;
  esac
done

[ "$#" -eq 0 ] || { echo "grok-speed: extra arguments: $*" >&2; exit 2; }

effort_label=${effort:-xhigh (config default)}
model_label=${model:-grok-4.6 (config default)}
echo "using model=${model_label}  effort=${effort_label}"

work=$(mktemp -d "${TMPDIR:-/tmp}/grok-speed.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

# Internal tool IDs. Keep the model from launching anything that burns wall time.
deny='run_terminal_cmd,read_file,grep,list_dir,write,search_replace,web_search,web_fetch,todo_write,Agent'

sum_gen=0
sum_api=0
ok=0

i=1
while [ "$i" -le "$repeats" ]; do
  out=$work/run-$i.jsonl
  err=$work/run-$i.err
  set -- "$GROK" -p "$prompt" \
      --cwd "$work" \
      --max-turns 1 \
      --output-format streaming-messages-json \
      --disable-web-search \
      --disallowed-tools "$deny"
  [ -n "$model" ] && set -- "$@" --model "$model"
  [ -n "$effort" ] && set -- "$@" --effort "$effort"
  if ! "$@" >"$out" 2>"$err"
  then
    echo "run $i: grok failed" >&2
    tail -n 20 "$err" >&2
    i=$((i + 1))
    continue
  fi

  eval "$(python3 - "$out" <<'PY'
import json, sys
result = None
model = ""
for line in open(sys.argv[1], encoding="utf-8"):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        obj = json.loads(line)
    except json.JSONDecodeError:
        continue
    if obj.get("type") == "assistant":
        msg = obj.get("message") or {}
        model = msg.get("model") or model
        u = msg.get("usage") or {}
    if obj.get("type") == "result":
        result = obj
if result is None:
    print("bad=1")
    raise SystemExit
usage = result.get("usage") or {}
rs = int(usage.get("reasoning_tokens") or 0)
out_tok = int(usage.get("output_tokens") or 0)
api = int(result.get("duration_api_ms") or 0)
wall = int(result.get("duration_ms") or 0)
model = model or result.get("model") or ""
# shell-safe
def q(s):
    return "'" + str(s).replace("'", "'\\''") + "'"
print(f"bad=0 rs={rs} out_tok={out_tok} api_ms={api} wall_ms={wall} model={q(model)}")
PY
)"

  if [ "${bad:-1}" -ne 0 ]; then
    echo "run $i: could not parse grok JSON" >&2
    i=$((i + 1))
    continue
  fi

  gen=$((rs + out_tok))
  if [ "$api_ms" -gt 0 ] && [ "$gen" -gt 0 ]; then
    api_s=$(python3 -c "print(f'{$api_ms/1000:.2f}')")
    tps=$(python3 -c "print(f'{$gen / ($api_ms/1000):.1f}')")
  else
    api_s="n/a"
    tps="n/a"
    echo "run $i: missing duration_api_ms or token counts" >&2
  fi
  wall_s=$(python3 -c "print(f'{$wall_ms/1000:.2f}')")

  printf 'run %s  model=%s  effort=%s  reasoning=%s  output=%s  api=%ss  think+write=%s tok/s  wall=%ss\n' \
    "$i" "${model:-?}" "$effort_label" "$rs" "$out_tok" "$api_s" "$tps" "$wall_s"

  if [ "$api_ms" -gt 0 ] && [ "$gen" -gt 0 ]; then
    sum_gen=$((sum_gen + gen))
    sum_api=$((sum_api + api_ms))
    ok=$((ok + 1))
  fi
  i=$((i + 1))
done

if [ "$ok" -ge 2 ]; then
  avg=$(python3 -c "print(f'{$sum_gen / ($sum_api/1000):.1f}')")
  printf 'avg over %s runs  think+write=%s tok/s  (reasoning+output)/api_time\n' "$ok" "$avg"
fi

[ "$ok" -ge 1 ] || exit 1
